    "CLM_S_40ace5af19": {
      "claim_id": "CLM_S_40ace5af19",
      "claim_text": "This has to do with the \"interspecies symbiosis\" which Bob Wilson speaks of; more precisely, what PKD term a homoplasmate comes into being, which is what Jesus was: homo (man); plasmate (Logos).",
      "claim_type": "theological",
      "lane": "B",
      "polarity": "assertive",
      "speaker": "PKD",
      "confidence": 0.8,
      "source_type": "segment",
