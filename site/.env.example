# Copy to .env.local (git-ignored) and fill in from your Supabase project:
# Supabase dashboard -> Project Settings -> API
#
# Both values are safe to expose in the browser bundle. The anon key only
# grants what the Row Level Security policies in supabase/schema.sql allow.
# Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
