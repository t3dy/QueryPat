{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://querypat.local/artifacts/public_prose.schema.json",
  "title": "PublicProseArtifact",
  "description": "Stage G. Final reader-facing prose. MUST be generated from prior artifacts (see contract), not directly from unstructured source material, except in explicitly marked prototype/emergency mode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "generated_at",
    "source_id",
    "generated_by",
    "input_artifact_ids",
    "title",
    "body_markdown",
    "editorial_status",
    "generated_from_artifacts"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 3 },
    "artifact_type": { "const": "public_prose" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_id": { "type": "string", "minLength": 1 },
    "generated_by": { "$ref": "#/$defs/generated_by" },

    "input_artifact_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "generated_from_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_type"],
        "properties": {
          "artifact_id": { "type": "string" },
          "artifact_type": { "type": "string" }
        }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "dek_or_short_description": { "type": ["string", "null"] },
    "body_markdown": { "type": "string", "minLength": 1 },
    "summary": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "citations_or_source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "uri": { "type": ["string", "null"] },
          "source_id": { "type": ["string", "null"] }
        }
      }
    },
    "editorial_status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
    "prototype_mode": { "type": "boolean", "description": "If true, this prose was allowed to skip the full pipeline. Such artifacts may never be 'reviewed' or 'published'." },
    "revision_notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_role", "name"],
      "properties": {
        "agent_role": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  }
}
