{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://querypat.local/artifacts/ontology_tagging.schema.json",
  "title": "OntologyTaggingArtifact",
  "description": "Stage D. Maps a raw extraction onto the portal's controlled vocabulary. Classifies only; MUST NOT write public prose. Controlled vocabularies live in artifacts/schemas/controlled_vocabulary.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "generated_at",
    "source_id",
    "generated_by",
    "input_artifact_id",
    "ontology_version"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 3 },
    "artifact_type": { "const": "ontology_tagging" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_id": { "type": "string", "minLength": 1 },
    "generated_by": { "$ref": "#/$defs/generated_by" },

    "input_artifact_id": { "type": "string", "minLength": 3 },
    "ontology_version": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "entities_linked_to_ontology_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mention", "ontology_id"],
        "properties": {
          "mention": { "type": "string" },
          "ontology_id": { "type": "string", "description": "e.g. term_id, name_id, work_id, theophany_id in the unified DB" },
          "ontology_kind": { "type": ["string", "null"], "description": "term | name | work | person | place | theme | theophany" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "traditions": { "type": "array", "items": { "type": "string" } },
    "periods": { "type": "array", "items": { "type": "string" } },
    "genres": { "type": "array", "items": { "type": "string" } },
    "methods": { "type": "array", "items": { "type": "string" } },
    "historiographical_categories": { "type": "array", "items": { "type": "string" } },
    "esoteric_domains": {
      "type": "array",
      "items": {
        "enum": [
          "western_esotericism", "renaissance_magic", "alchemy", "hermetism", "neoplatonism",
          "christian_kabbalah", "jewish_kabbalah", "grimoires", "ritual_magic", "astrology",
          "witchcraft_studies", "gnosticism", "theosophy", "rosicrucianism", "freemasonry",
          "divination", "mysticism", "history_of_science", "manuscript_studies", "book_history",
          "iconography", "historiography", "methodology", "primary_source_discussion", "other"
        ]
      }
    },
    "evidentiary_lane": { "type": ["string", "null"], "description": "A|B|C|D|E per PKDontology.md" },
    "confidence_by_tag": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "confidence"],
        "properties": {
          "tag": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "rejected_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "reason"],
        "properties": {
          "tag": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "tagging_notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_role", "name"],
      "properties": {
        "agent_role": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  }
}
