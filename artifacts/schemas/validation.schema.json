{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://querypat.local/artifacts/validation.schema.json",
  "title": "ValidationArtifact",
  "description": "Stage C. Checks whether a target artifact is complete, grounded, and schema-valid. Warnings should not block work; failures should prevent publishing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "generated_at",
    "source_id",
    "generated_by",
    "target_artifact_id",
    "validation_status"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 3 },
    "artifact_type": { "const": "validation" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_id": { "type": "string", "minLength": 1 },
    "generated_by": { "$ref": "#/$defs/generated_by" },

    "target_artifact_id": { "type": "string", "minLength": 3 },
    "target_artifact_type": { "type": ["string", "null"] },
    "validation_status": { "enum": ["pass", "warn", "fail"] },
    "schema_errors": { "type": "array", "items": { "type": "string" } },
    "missing_required_fields": { "type": "array", "items": { "type": "string" } },
    "grounding_issues": { "type": "array", "items": { "type": "string" } },
    "suspected_hallucinations": { "type": "array", "items": { "type": "string" } },
    "duplicate_or_conflicting_claims": { "type": "array", "items": { "type": "string" } },
    "recommended_fixes": { "type": "array", "items": { "type": "string" } },
    "validator_notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_role", "name"],
      "properties": {
        "agent_role": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  }
}
