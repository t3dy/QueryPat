{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://querypat.local/artifacts/source_metadata.schema.json",
  "title": "SourceMetadataArtifact",
  "description": "Stage A. Represents an ingested source before any interpretation. Pure provenance and access metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "generated_at",
    "source_id",
    "generated_by",
    "source_type",
    "source_title"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 3 },
    "artifact_type": { "const": "source_metadata" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_id": { "type": "string", "minLength": 1 },
    "generated_by": { "$ref": "#/$defs/generated_by" },

    "source_type": {
      "enum": ["pdf", "book", "article", "podcast_episode", "youtube_video", "webpage", "manuscript", "database_record", "other"]
    },
    "source_title": { "type": "string", "minLength": 1 },
    "authors_or_creators": { "type": "array", "items": { "type": "string" } },
    "publication_date": { "type": ["string", "null"] },
    "source_uri": { "type": ["string", "null"] },
    "local_path": { "type": ["string", "null"] },
    "ingestion_date": { "type": ["string", "null"] },
    "language": { "type": ["string", "null"] },
    "rights_status": { "type": ["string", "null"] },
    "access_notes": { "type": ["string", "null"] },
    "raw_text_available": { "type": "boolean" },
    "transcript_available": { "type": "boolean" },
    "evidentiary_lane": { "type": ["string", "null"], "description": "A|B|C|D|E per PKDontology.md, when applicable" },
    "notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_role", "name"],
      "properties": {
        "agent_role": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  }
}
