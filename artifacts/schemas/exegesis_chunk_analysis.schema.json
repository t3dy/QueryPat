{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://querypat.local/artifacts/exegesis_chunk_analysis.schema.json",
  "title": "ExegesisCunkAnalysisArtifact",
  "description": "Systematic reading note for a chunk/section of PKD's Exegesis. Captures theological, philosophical, and mystical themes with evidence locations to prevent re-reading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "generated_at",
    "source_id",
    "generated_by",
    "chunk_identifier",
    "summary",
    "theological_themes"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 3 },
    "artifact_type": { "const": "exegesis_chunk_analysis" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_id": { "type": "string", "minLength": 1, "description": "Exegesis source ID" },
    "generated_by": { "$ref": "#/$defs/generated_by" },
    "chunk_identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator"],
      "properties": {
        "locator": { "type": "string", "description": "e.g., 'Entry 42', 'Date: 3-74', 'Folder 18, pages 1-5'" },
        "date_written": { "type": ["string", "null"], "description": "When PKD wrote this, if known" },
        "page_range": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "string",
      "description": "What PKD is discussing: his experiences, realizations, theological framework, arguments"
    },
    "theological_themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme", "description"],
        "properties": {
          "theme": { "type": "string", "description": "e.g., VALIS, Sophia, Gnostic dualism, Divine madness" },
          "description": { "type": "string" },
          "tradition": { "type": ["string", "null"], "description": "gnostic, christian, neoplatonic, mystical, buddhist, etc." },
          "evidence_excerpt": { "type": ["string", "null"], "description": "Direct quote from text" }
        }
      }
    },
    "philosophical_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "concept": { "type": "string" },
          "how_developed": { "type": ["string", "null"] },
          "relation_to_theology": { "type": ["string", "null"] }
        }
      }
    },
    "mystical_experiences_discussed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "experience_type": { "type": "string", "description": "vision, voice, synchronicity, theophany, etc." },
          "description": { "type": ["string", "null"] },
          "date": { "type": ["string", "null"] },
          "theological_interpretation": { "type": ["string", "null"], "description": "How PKD interprets it spiritually" }
        }
      }
    },
    "connections_to_works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "work_id": { "type": "string" },
          "connection_type": { "type": "string", "enum": ["thematic_source", "character_inspiration", "plot_element", "theological_framework"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "key_figures_mentioned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "context": { "type": ["string", "null"] }
        }
      }
    },
    "spiritual_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "confidence_level": { "type": ["string", "null"], "enum": ["certain", "strong_belief", "tentative", "questioning"] },
          "supporting_evidence": { "type": ["string", "null"] }
        }
      }
    },
    "contradictions_or_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "earlier_claim": { "type": "string" },
          "revision": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "theological_influences_evident": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Christian theology, Gnosticism, Neoplatonism, Buddhism, etc."
    },
    "questions_posed": { "type": "array", "items": { "type": "string" } },
    "reading_notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_role", "name"],
      "properties": {
        "agent_role": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  }
}
