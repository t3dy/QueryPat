{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://querypat.local/artifacts/letter_annotation.schema.json",
  "title": "LetterAnnotationArtifact",
  "description": "Systematic reading note for letters (correspondence). Captures biographical events, themes, relationships, and intellectual content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "generated_at",
    "source_id",
    "generated_by",
    "letter_identifier",
    "summary"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 3 },
    "artifact_type": { "const": "letter_annotation" },
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_id": { "type": "string", "minLength": 1 },
    "generated_by": { "$ref": "#/$defs/generated_by" },
    "letter_identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "recipient"],
      "properties": {
        "date": { "type": "string", "description": "When PKD wrote this letter" },
        "recipient": { "type": "string" },
        "location_written": { "type": ["string", "null"] },
        "letter_number": { "type": ["integer", "string", "null"], "description": "Position in collection if part of ordered series" }
      }
    },
    "summary": {
      "type": "string",
      "description": "What PKD discusses in the letter: personal matters, literary thoughts, philosophical ideas, biographical events"
    },
    "biographical_events_mentioned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event": { "type": "string" },
          "date": { "type": ["string", "null"] },
          "significance": { "type": ["string", "null"] }
        }
      }
    },
    "relationship_with_recipient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationship_type": { "type": ["string", "null"], "description": "friend, editor, publisher, fellow_writer, colleague" },
        "tone": { "type": ["string", "null"], "description": "intimate, formal, playful, desperate, intellectual, etc." },
        "context": { "type": ["string", "null"], "description": "Any relevant context about their relationship" }
      }
    },
    "literary_and_intellectual_content": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string", "description": "Writing, philosophy, theology, science, society, etc." },
          "discussion": { "type": ["string", "null"] },
          "position_or_argument": { "type": ["string", "null"] }
        }
      }
    },
    "works_mentioned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "work_id": { "type": "string" },
          "context": { "type": ["string", "null"] }
        }
      }
    },
    "locations_referenced": {
      "type": "array",
      "items": { "type": "string" }
    },
    "people_mentioned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "context": { "type": ["string", "null"] }
        }
      }
    },
    "theological_or_spiritual_content": {
      "type": ["string", "null"],
      "description": "Any discussion of religious/spiritual matters, the Exegesis work, mystical experiences"
    },
    "personal_struggles_mentioned": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "struggle": { "type": "string" },
          "context": { "type": ["string", "null"] }
        }
      }
    },
    "health_or_substance_references": {
      "type": "array",
      "items": {
        "type": "string" },
      "description": "References to drugs, illness, medical issues, mental state"
    },
    "connections_to_exegesis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "How this letter relates to themes in the Exegesis"
    },
    "key_quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quote": { "type": "string" },
          "significance": { "type": ["string", "null"] }
        }
      }
    },
    "reading_notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_role", "name"],
      "properties": {
        "agent_role": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] }
      }
    }
  }
}
